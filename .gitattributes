# Normalize line endings to LF on commit, checkout as-is on each platform
* text=auto

# Dart/Flutter source files — always LF
*.dart text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.gradle text eol=lf
*.kt   text eol=lf
*.java text eol=lf
*.xml  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# Shell scripts — must be LF
*.sh   text eol=lf

# Windows scripts — CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files — no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.eot  binary
*.pdf  binary
*.zip  binary
*.apk  binary
*.aar  binary
*.so   binary
*.jar  binary
